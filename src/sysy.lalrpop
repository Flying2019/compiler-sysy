// lalrpop 里的约定
grammar;
use compile_sysy::lalr::*;
use compile_sysy::lexer::{LexError, Tok};

extern {
  type Location = usize;
  type Error = LexError;
  enum Tok {
    "Ident" => Tok::Ident(<String>),
    "TypeIdent" => Tok::TypeIdent(<String>),
    "IntConst" => Tok::IntConst(<i32>),
    "int" => Tok::Int,
    "void" => Tok::Void,
    "const" => Tok::Const,
    "struct" => Tok::Struct,
    "if" => Tok::If,
    "else" => Tok::Else,
    "while" => Tok::While,
    "continue" => Tok::Continue,
    "break" => Tok::Break,
    "return" => Tok::Return,
    "new" => Tok::New,
    "async" => Tok::Async,
    "await" => Tok::Await,
    "Promise" => Tok::Promise,
    "sleep" => Tok::Sleep,
    "wait" => Tok::Wait,
    "+" => Tok::Plus,
    "-" => Tok::Minus,
    "*" => Tok::Star,
    "/" => Tok::Slash,
    "%" => Tok::Percent,
    "!" => Tok::Bang,
    "&" => Tok::Amp,
    "&&" => Tok::AmpAmp,
    "||" => Tok::PipePipe,
    "=" => Tok::Assign,
    "==" => Tok::EqEq,
    "!=" => Tok::Ne,
    "<" => Tok::Lt,
    "<=" => Tok::Le,
    ">" => Tok::Gt,
    ">=" => Tok::Ge,
    "(" => Tok::LParen,
    ")" => Tok::RParen,
    "{" => Tok::LBrace,
    "}" => Tok::RBrace,
    "[" => Tok::LBracket,
    "]" => Tok::RBracket,
    "," => Tok::Comma,
    ";" => Tok::Semicolon,
    "." => Tok::Dot,
    "->" => Tok::Arrow,
  }
}

Ident: String = "Ident" => <>;
TypeIdent: String = "TypeIdent" => <>;
StructName: String = {
  <Ident> => <>,
  <TypeIdent> => <>,
}

IntConst: i32 = "IntConst" => <>;

pub CompUnit: CompUnit = {
  <global_def: GlobalDef> => CompUnit { global_defs: vec![<>] },
  <global_def: GlobalDef> <comp_unit: CompUnit> => {
    let mut global_defs = vec![global_def];
    global_defs.extend(comp_unit.global_defs);
    CompUnit { global_defs: global_defs }
  },
}

GlobalDef: GlobalDef = {
  <StructDef> => GlobalDef::StructDef(<>),
  <FuncDef> => GlobalDef::FuncDef(<>),
  <Type> <MultipleDecl> ";" => GlobalDef::GlobalDecl(<>),
}

StructDef: StructDef = {
  <l:@L> "struct" <name: StructName> "{" <fields: StructFields> "}" ";" <r:@R> => StructDef { span: Some(Span { start: l, end: r }), name, fields },
  <l:@L> <name: Ident> "{" <fields: StructFields> "}" ";" <r:@R> => StructDef { span: Some(Span { start: l, end: r }), name, fields },
}

StructFields: Vec<StructField> = {
  => Vec::new(),
  <field: StructField> <rest: StructFields> => {
    let mut fields = vec![field];
    fields.extend(rest);
    fields
  }
}

StructField: StructField = {
  <l:@L> <ty: Type> <decls: MultipleDecl> ";" <r:@R> => StructField { span: Some(Span { start: l, end: r }), ty, decls },
}

FuncDef: FuncDef = {
  <l:@L> <func_type: Type> <ident: Ident> "(" <func_params: FuncParams> ")" <block: Block> <r:@R> => FuncDef { span: Some(Span { start: l, end: r }), is_async: false, func_type, ident, func_params, block },
  <l:@L> "async" <func_type: Type> <ident: Ident> "(" <func_params: FuncParams> ")" <block: Block> <r:@R> => FuncDef { span: Some(Span { start: l, end: r }), is_async: true, func_type, ident, func_params, block },
}

FuncParams: Vec<FuncParam> = {
  => Vec::new(),
  <FuncParam> => vec![<>],
  <single_param: FuncParam> "," <rest: FuncParams> => {
    let mut params = vec![single_param];
    params.extend(rest);
    params
  }
}

FuncParam: FuncParam = {
  <ty: Type> <name: Ident> => FuncParam {
    btype: param_base_btype(ty),
    name,
    array_dims: None,
  },
  <ty: Type> <name: Ident> "[" "]" <dims: FuncParamDims> => FuncParam {
    btype: param_base_btype(ty),
    name,
    array_dims: Some(dims),
  },
};

FuncParamDims: Vec<Exp> = {
  => Vec::new(),
  "[" <dim: Exp> "]" <rest: FuncParamDims> => {
    let mut dims = vec![dim];
    dims.extend(rest);
    dims
  }
}

Block: Vec<Stmt> = "{" <stmts: StmtList> "}" => stmts;

StmtList: Vec<Stmt> = {
  => Vec::new(),
  <stmt: Stmt> <rest: StmtList> => {
    let mut stmts = vec![stmt];
    stmts.extend(rest);
    stmts
  }
};

Stmt: Stmt = {
  OpenStmt => <>,
  ClosedStmt => <>,
}

OpenStmt: Stmt = {
  <l:@L> "if" "(" <exp: Exp> ")" <stmt: Stmt> <r:@R> => spanned_stmt(Stmt::If(exp, Box::new(stmt)), l, r),
  <l:@L> "if" "(" <exp: Exp> ")" <then_stmt: ClosedStmt> "else" <else_stmt: OpenStmt> <r:@R> => spanned_stmt(Stmt::IfElse(exp, Box::new(then_stmt), Box::new(else_stmt)), l, r),
}

ClosedStmt: Stmt = {
  NonIfStmt => <>,
  <l:@L> "if" "(" <exp: Exp> ")" <then_stmt: ClosedStmt> "else" <else_stmt: ClosedStmt> <r:@R> => spanned_stmt(Stmt::IfElse(exp, Box::new(then_stmt), Box::new(else_stmt)), l, r),
}

NonIfStmt: Stmt = {
  <l:@L> <ty: Type> <decls: MultipleDecl> ";" <r:@R> => spanned_stmt(Stmt::Decl(ty, decls), l, r),
  <l:@L> "while" "(" <exp: Exp> ")" <stmt: NonIfStmt> <r:@R> => spanned_stmt(Stmt::While(exp, Box::new(stmt)), l, r),
  <l:@L> "continue" ";" <r:@R> => spanned_stmt(Stmt::Continue, l, r),
  <l:@L> "break" ";" <r:@R> => spanned_stmt(Stmt::Break, l, r),
  <l:@L> <block: Block> <r:@R> => spanned_stmt(Stmt::Block(block), l, r),
  <l:@L> <lhs: ArrayExp> "=" <rhs: Exp> ";" <r:@R> => spanned_stmt(Stmt::Assign(lhs, rhs), l, r),
  <l:@L> "return" <exp: Exp> ";" <r:@R> => spanned_stmt(Stmt::Return(Some(exp)), l, r),
  <l:@L> "return" ";" <r:@R> => spanned_stmt(Stmt::Return(None), l, r),
  <l:@L> <exp: Exp> ";" <r:@R> => spanned_stmt(Stmt::Exp(exp), l, r),
  <l:@L> ";" <r:@R> => spanned_stmt(Stmt::Empty, l, r),
}

MultipleDecl: Vec<SingleDecl> = {
  <SingleDecl> => vec![<>],
  <single_decl: SingleDecl> "," <rest: MultipleDecl> => {
    let mut decls = vec![single_decl];
    decls.extend(rest);
    decls
  }
}

InitVal: InitVal = {
  <l:@L> <exp: Exp> <r:@R> => spanned_init(InitVal::Exp(exp), l, r),
  <l:@L> "{" <items: MultiInitVal> "}" <r:@R> => spanned_init(InitVal::Arr(items), l, r)
}

MultiInitVal: Vec<InitVal> = {
  => Vec::new(),
  <InitVal> => vec![<>],
  <single_init: InitVal> "," <rest: MultiInitVal> => {
    let mut inits = vec![single_init];
    inits.extend(rest);
    inits
  }
}

VarDecl: VarDecl = {
  <Ident> => VarDecl::Ident(<>),
  <var: VarDecl> "[" <exp: Exp> "]" => VarDecl::Array(Box::new(var), exp)
}

SingleDecl: SingleDecl = {
  <l:@L> <var: VarDecl> <r:@R> => SingleDecl { span: Some(Span { start: l, end: r }), var: var, init: None },
  <l:@L> <var: VarDecl> "=" <init_val: InitVal> <r:@R> => SingleDecl { span: Some(Span { start: l, end: r }), var: var, init: Some(init_val) },
}

FuncArgs: Vec<Exp> = {
  <Exp> => vec![<>],
  <single_arg: Exp> "," <rest: FuncArgs> => {
    let mut args = vec![single_arg];
    args.extend(rest);
    args
  }
}

BType: BType = {
  <base: BTypeBase> => base,
  <base: BType> "*" => BType::Ptr(Box::new(base)),
}

BTypeBase: BType = {
  "int" => BType::I32,
  "void" => BType::Void,
  "struct" <ident: StructName> => BType::Struct(ident),
  "Promise" "<" <inner: BType> ">" => BType::Promise(Box::new(inner)),
  <ident: TypeIdent> => BType::Struct(ident),
}

Type: Type = {
  "const" <BType> => Type::Const(<>),
  <BType> => Type::BType(<>),
}

Exp: Exp = {
  <LOrExp> => <>,
}

ArrayExp: Exp = {
  <l:@L> <ident: Ident> <r:@R> => spanned_exp(Exp::Ident(ident), l, r),
  <l:@L> <arr: ArrayExp> "[" <pos: Exp> "]" <r:@R> => spanned_exp(Exp::ArrGet(Box::new(arr), Box::new(pos)), l, r),
  <l:@L> <arr: ArrayExp> "." <field: Ident> <r:@R> => spanned_exp(Exp::Field(Box::new(arr), field), l, r),
  <l:@L> <promise: ArrayExp> "." "wait" "(" ")" <r:@R> => spanned_exp(Exp::PromiseWait(Box::new(promise)), l, r),
  <l:@L> <arr: ArrayExp> "->" <field: Ident> <r:@R> => spanned_exp(Exp::PtrField(Box::new(arr), field), l, r),
}

PrimaryExp: Exp = {
  <l:@L> "new" <ty: BTypeBase> <r:@R> => spanned_exp(Exp::New(ty), l, r),
  <l:@L> "await" <exp: UnaryExp> <r:@R> => spanned_exp(Exp::Await(Box::new(exp)), l, r),
  <l:@L> "sleep" "(" <duration: Exp> ")" <r:@R> => spanned_exp(Exp::Sleep(Box::new(duration)), l, r),
  <ArrayExp> => <>,
  <l:@L> <ident: Ident> "(" ")" <r:@R> => spanned_exp(Exp::FuncCall(ident, Vec::new()), l, r),
  <l:@L> <ident: Ident> "(" <args: FuncArgs> ")" <r:@R> => spanned_exp(Exp::FuncCall(ident, args), l, r),
  "(" <Exp> ")" => <>,
  <l:@L> <value: IntConst> <r:@R> => spanned_exp(Exp::Number(value), l, r),
}

UnaryExp: Exp = {
  <PrimaryExp> => <>,
  <l:@L> <op: UnaryOp> <exp: UnaryExp> <r:@R> => spanned_exp(Exp::UnaryExp(op, Box::new(exp)), l, r),
}

MulExp: Exp = {
  <UnaryExp> => <>,
  <l:@L> <mul_exp: MulExp> <op: MulOp> <unary_exp: UnaryExp> <r:@R> => spanned_exp(Exp::BinaryExp(op, Box::new(mul_exp), Box::new(unary_exp)), l, r),
}

AddExp: Exp = {
  <MulExp> => <>,
  <l:@L> <add_exp: AddExp> <op: AddOp> <mul_exp: MulExp> <r:@R> => spanned_exp(Exp::BinaryExp(op, Box::new(add_exp), Box::new(mul_exp)), l, r),
}

UnaryOp: UnaryOp = {
  "+" => UnaryOp::Pos,
  "-" => UnaryOp::Neg,
  "!" => UnaryOp::Not,
  "&" => UnaryOp::Addr,
  "*" => UnaryOp::Deref,
}

MulOp: BinaryOp = {
  "*" => BinaryOp::Mul,
  "/" => BinaryOp::Div,
  "%" => BinaryOp::Mod,
}

AddOp: BinaryOp = {
  "+" => BinaryOp::Add,
  "-" => BinaryOp::Sub,
}

RelExp: Exp = {
  AddExp => <>,
  <l:@L> <rel_exp: RelExp> <op: RelOp> <add_exp: AddExp> <r:@R> => spanned_exp(Exp::BinaryExp(op, Box::new(rel_exp), Box::new(add_exp)), l, r),
}

RelOp: BinaryOp = {
  "<" => BinaryOp::Lt,
  ">" => BinaryOp::Gt,
  "<=" => BinaryOp::Le,
  ">=" => BinaryOp::Ge,
}

EqExp: Exp = {
  RelExp => <>,
  <l:@L> <eq_exp: EqExp> <op: EqOp> <rel_exp: RelExp> <r:@R> => spanned_exp(Exp::BinaryExp(op, Box::new(eq_exp), Box::new(rel_exp)), l, r),
}

EqOp: BinaryOp = {
  "==" => BinaryOp::Eq,
  "!=" => BinaryOp::Ne,
}

LAndExp: Exp = {
  EqExp => <>,
  <l:@L> <land_exp: LAndExp> "&&" <eq_exp: EqExp> <r:@R> => spanned_exp(Exp::BinaryExp(BinaryOp::And, Box::new(land_exp), Box::new(eq_exp)), l, r),
}

LOrExp: Exp = {
  LAndExp => <>,
  <l:@L> <lor_exp: LOrExp> "||" <land_exp: LAndExp> <r:@R> => spanned_exp(Exp::BinaryExp(BinaryOp::Or, Box::new(lor_exp), Box::new(land_exp)), l, r),
}
