// lalrpop 里的约定
grammar;
use compile_sysy::lalr::*;
use compile_sysy::lexer::{LexError, Tok};

extern {
  type Location = usize;
  type Error = LexError;
  enum Tok {
    "Ident" => Tok::Ident(<String>),
    "TypeIdent" => Tok::TypeIdent(<String>),
    "IntConst" => Tok::IntConst(<i32>),
    "int" => Tok::Int,
    "void" => Tok::Void,
    "const" => Tok::Const,
    "struct" => Tok::Struct,
    "if" => Tok::If,
    "else" => Tok::Else,
    "while" => Tok::While,
    "continue" => Tok::Continue,
    "break" => Tok::Break,
    "return" => Tok::Return,
    "new" => Tok::New,
    "async" => Tok::Async,
    "await" => Tok::Await,
    "Promise" => Tok::Promise,
    "sleep" => Tok::Sleep,
    "addSyncFunc" => Tok::AddSyncFunc,
    "wait" => Tok::Wait,
    "+" => Tok::Plus,
    "-" => Tok::Minus,
    "*" => Tok::Star,
    "/" => Tok::Slash,
    "%" => Tok::Percent,
    "!" => Tok::Bang,
    "&" => Tok::Amp,
    "&&" => Tok::AmpAmp,
    "||" => Tok::PipePipe,
    "=" => Tok::Assign,
    "==" => Tok::EqEq,
    "!=" => Tok::Ne,
    "<" => Tok::Lt,
    "<=" => Tok::Le,
    ">" => Tok::Gt,
    ">=" => Tok::Ge,
    "(" => Tok::LParen,
    ")" => Tok::RParen,
    "{" => Tok::LBrace,
    "}" => Tok::RBrace,
    "[" => Tok::LBracket,
    "]" => Tok::RBracket,
    "," => Tok::Comma,
    ";" => Tok::Semicolon,
    "." => Tok::Dot,
    "->" => Tok::Arrow,
  }
}

Ident: String = "Ident" => <>;
TypeIdent: String = "TypeIdent" => <>;
StructName: String = {
  <Ident> => <>,
  <TypeIdent> => <>,
}

IntConst: i32 = "IntConst" => <>;

pub CompUnit: CompUnit = {
  <glob_def: GlobleDef> => CompUnit { glob_defs: vec![<>] },
  <glob_def: GlobleDef> <comp_unit: CompUnit> => {
    let mut glob_defs = vec![glob_def];
    glob_defs.extend(comp_unit.glob_defs);
    CompUnit { glob_defs: glob_defs }
  },
}

GlobleDef: GlobleDef = {
  <StructDef> => GlobleDef::StructDef(<>),
  <FuncDef> => GlobleDef::FuncDef(<>),
  <Type> <MultipleDecl> ";" => GlobleDef::GlobleDecl(<>),
}

StructDef: StructDef = {
  "struct" <name: StructName> "{" <fields: StructFields> "}" ";" => StructDef { name, fields },
  <name: Ident> "{" <fields: StructFields> "}" ";" => StructDef { name, fields },
}

StructFields: Vec<StructField> = {
  => Vec::new(),
  <field: StructField> <rest: StructFields> => {
    let mut fields = vec![field];
    fields.extend(rest);
    fields
  }
}

StructField: StructField = {
  <ty: Type> <decls: MultipleDecl> ";" => StructField { ty, decls },
}

FuncDef: FuncDef = {
  <func_type: Type> <ident: Ident> "(" <func_params: FuncParams> ")" <block: Block> => FuncDef { is_async: false, func_type, ident, func_params, block },
  "async" <func_type: Type> <ident: Ident> "(" <func_params: FuncParams> ")" <block: Block> => FuncDef { is_async: true, func_type, ident, func_params, block },
}

FuncParams: Vec<FuncParam> = {
  => Vec::new(),
  <FuncParam> => vec![<>],
  <single_param: FuncParam> "," <rest: FuncParams> => {
    let mut params = vec![single_param];
    params.extend(rest);
    params
  }
}

FuncParam: FuncParam = {
  <ty: Type> <name: Ident> => FuncParam {
    btype: param_base_btype(ty),
    name,
    array_dims: None,
  },
  <ty: Type> <name: Ident> "[" "]" <dims: FuncParamDims> => FuncParam {
    btype: param_base_btype(ty),
    name,
    array_dims: Some(dims),
  },
};

FuncParamDims: Vec<Exp> = {
  => Vec::new(),
  "[" <dim: Exp> "]" <rest: FuncParamDims> => {
    let mut dims = vec![dim];
    dims.extend(rest);
    dims
  }
}

Block: Vec<Stmt> = "{" <stmts: StmtList> "}" => stmts;

StmtList: Vec<Stmt> = {
  => Vec::new(),
  <stmt: Stmt> <rest: StmtList> => {
    let mut stmts = vec![stmt];
    stmts.extend(rest);
    stmts
  }
};

Stmt: Stmt = {
  OpenStmt => <>,
  ClosedStmt => <>,
}

OpenStmt: Stmt = {
  "if" "(" <exp: Exp> ")" <stmt: Stmt> => Stmt::If(exp, Box::new(stmt)),
  "if" "(" <exp: Exp> ")" <then_stmt: ClosedStmt> "else" <else_stmt: OpenStmt> => Stmt::IfElse(exp, Box::new(then_stmt), Box::new(else_stmt)),
}

ClosedStmt: Stmt = {
  NonIfStmt => <>,
  "if" "(" <exp: Exp> ")" <then_stmt: ClosedStmt> "else" <else_stmt: ClosedStmt> => Stmt::IfElse(exp, Box::new(then_stmt), Box::new(else_stmt)),
}

NonIfStmt: Stmt = {
  <Type> <MultipleDecl> ";" => Stmt::Decl(<>),
  "while" "(" <exp: Exp> ")" <stmt: NonIfStmt> => Stmt::While(exp, Box::new(stmt)),
  "continue" ";" => Stmt::Continue,
  "break" ";" => Stmt::Break,
  "addSyncFunc" "(" <exp: Exp> ")" ";" => Stmt::AddSyncFunc(exp),
  "wait" "(" ")" ";" => Stmt::Wait,
  <Block> => Stmt::Block(<>),
  <ArrayExp> "=" <Exp> ";" => Stmt::Assign(<>),
  "return" <Exp> ";" => Stmt::Return(Some(<>)),
  "return" ";" => Stmt::Return(None),
  <Exp> ";" => Stmt::Exp(<>),
  ";" => Stmt::Empty,
}

MultipleDecl: Vec<SingleDecl> = {
  <SingleDecl> => vec![<>],
  <single_decl: SingleDecl> "," <rest: MultipleDecl> => {
    let mut decls = vec![single_decl];
    decls.extend(rest);
    decls
  }
}

InitVal: InitVal = {
  <exp: Exp> => InitVal::Exp(<>),
  "{" <MultiInitVal> "}" => InitVal::Arr(<>)
}

MultiInitVal: Vec<InitVal> = {
  => Vec::new(),
  <InitVal> => vec![<>],
  <single_init: InitVal> "," <rest: MultiInitVal> => {
    let mut inits = vec![single_init];
    inits.extend(rest);
    inits
  }
}

VarDecl: VarDecl = {
  <Ident> => VarDecl::Ident(<>),
  <var: VarDecl> "[" <exp: Exp> "]" => VarDecl::Array(Box::new(var), exp)
}

SingleDecl: SingleDecl = {
  <var: VarDecl> => SingleDecl { var: var, init: None },
  <var: VarDecl> "=" <init_val: InitVal> => SingleDecl { var: var, init: Some(init_val) },
}

FuncArgs: Vec<Exp> = {
  <Exp> => vec![<>],
  <single_arg: Exp> "," <rest: FuncArgs> => {
    let mut args = vec![single_arg];
    args.extend(rest);
    args
  }
}

BType: BType = {
  <base: BTypeBase> => base,
  <base: BType> "*" => BType::Ptr(Box::new(base)),
}

BTypeBase: BType = {
  "int" => BType::I32,
  "void" => BType::Void,
  "struct" <ident: StructName> => BType::Struct(ident),
  "Promise" "<" <inner: BType> ">" => BType::Promise(Box::new(inner)),
  <ident: TypeIdent> => BType::Struct(ident),
}

Type: Type = {
  "const" <BType> => Type::Const(<>),
  <BType> => Type::BType(<>),
}

Exp: Exp = {
  <LOrExp> => <>,
}

ArrayExp: Exp = {
  <Ident> => Exp::Ident(<>),
  <arr: ArrayExp> "[" <pos: Exp> "]" => Exp::ArrGet(Box::new(arr), Box::new(pos)),
  <arr: ArrayExp> "." <field: Ident> => Exp::Field(Box::new(arr), field),
  <arr: ArrayExp> "->" <field: Ident> => Exp::PtrField(Box::new(arr), field),
}

PrimaryExp: Exp = {
  "new" <ty: BTypeBase> => Exp::New(ty),
  "await" <exp: UnaryExp> => Exp::Await(Box::new(exp)),
  "sleep" "(" <duration: Exp> ")" => Exp::Sleep(Box::new(duration)),
  <ArrayExp> => <>,
  <ident: Ident> "(" ")" => Exp::FuncCall(ident, Vec::new()),
  <Ident> "(" <FuncArgs> ")" => Exp::FuncCall(<>),
  "(" <Exp> ")" => <>,
  <IntConst> => Exp::Number(<>),
}

UnaryExp: Exp = {
  <PrimaryExp> => <>,
  <op: UnaryOp> <exp: UnaryExp> => Exp::UnaryExp(op, Box::new(exp)),
}

MulExp: Exp = {
  <UnaryExp> => <>,
  <mul_exp: MulExp> <op: MulOp> <unary_exp: UnaryExp> => Exp::BinaryExp(op, Box::new(mul_exp), Box::new(unary_exp)),
}

AddExp: Exp = {
  <MulExp> => <>,
  <add_exp: AddExp> <op: AddOp> <mul_exp: MulExp> => Exp::BinaryExp(op, Box::new(add_exp), Box::new(mul_exp)),
}

UnaryOp: UnaryOp = {
  "+" => UnaryOp::Pos,
  "-" => UnaryOp::Neg,
  "!" => UnaryOp::Not,
  "&" => UnaryOp::Addr,
  "*" => UnaryOp::Deref,
}

MulOp: BinaryOp = {
  "*" => BinaryOp::Mul,
  "/" => BinaryOp::Div,
  "%" => BinaryOp::Mod,
}

AddOp: BinaryOp = {
  "+" => BinaryOp::Add,
  "-" => BinaryOp::Sub,
}

RelExp: Exp = {
  AddExp => <>,
  <rel_exp: RelExp> <op: RelOp> <add_exp: AddExp> => Exp::BinaryExp(op, Box::new(rel_exp), Box::new(add_exp)),
}

RelOp: BinaryOp = {
  "<" => BinaryOp::Lt,
  ">" => BinaryOp::Gt,
  "<=" => BinaryOp::Le,
  ">=" => BinaryOp::Ge,
}

EqExp: Exp = {
  RelExp => <>,
  <eq_exp: EqExp> <op: EqOp> <rel_exp: RelExp> => Exp::BinaryExp(op, Box::new(eq_exp), Box::new(rel_exp)),
}

EqOp: BinaryOp = {
  "==" => BinaryOp::Eq,
  "!=" => BinaryOp::Ne,
}

LAndExp: Exp = {
  EqExp => <>,
  <land_exp: LAndExp> "&&" <eq_exp: EqExp> => Exp::BinaryExp(BinaryOp::And, Box::new(land_exp), Box::new(eq_exp)),
}

LOrExp: Exp = {
  LAndExp => <>,
  <lor_exp: LOrExp> "||" <land_exp: LAndExp> => Exp::BinaryExp(BinaryOp::Or, Box::new(lor_exp), Box::new(land_exp)),
}
