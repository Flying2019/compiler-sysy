// lalrpop 里的约定
grammar;
use compile_sysy::lalr::*;

match {
  r"\s*" => {},
  r"//[^\n\r]*[\n\r]*" => {},
  r"/\*([^*]|\*[^/])*\*/" => {},
  _
}

Ident: String = r"[_a-zA-Z][_a-zA-Z0-9]*" => <>.to_string();

IntConst: i32 = {
  r"[1-9][0-9]*" => i32::from_str_radix(<>, 10).unwrap(),
  r"0[0-7]*" => i32::from_str_radix(<>, 8).unwrap(),
  r"0[xX][0-9a-fA-F]+" => i32::from_str_radix(&<>[2..], 16).unwrap(),
}

pub CompUnit: CompUnit = <func_def: FuncDef> => CompUnit { <> };

FuncDef: FuncDef = {
  <func_type: FuncType> <ident: Ident> "(" ")" <block: Block> => FuncDef { <> }
}

FuncType: FuncType =
  "int" => FuncType::Int;

Block: Vec<Stmt> = "{" <stmts: StmtList> "}" => stmts;

StmtList: Vec<Stmt> = {
  => Vec::new(),
  <stmt: Stmt> <rest: StmtList> => {
    let mut stmts = vec![stmt];
    stmts.extend(rest);
    stmts
  }
};

Stmt: Stmt = {
  OpenStmt => <>,
  ClosedStmt => <>,
}

OpenStmt: Stmt = {
  "if" "(" <exp: Exp> ")" <stmt: Stmt> => Stmt::If(exp, Box::new(stmt)),
  "if" "(" <exp: Exp> ")" <then_stmt: ClosedStmt> "else" <else_stmt: OpenStmt> => Stmt::IfElse(exp, Box::new(then_stmt), Box::new(else_stmt)),
}

ClosedStmt: Stmt = {
  NonIfStmt => <>,
  "if" "(" <exp: Exp> ")" <then_stmt: ClosedStmt> "else" <else_stmt: ClosedStmt> => Stmt::IfElse(exp, Box::new(then_stmt), Box::new(else_stmt)),
}

NonIfStmt: Stmt = {
  <Type> <MultipleDecl> ";" => Stmt::Decl(<>),
  "while" "(" <exp: Exp> ")" <stmt: NonIfStmt> => Stmt::While(exp, Box::new(stmt)),
  "continue" ";" => Stmt::Continue,
  "break" ";" => Stmt::Break,
  <Block> => Stmt::Block(<>),
  <Ident> "=" <Exp> ";" => Stmt::Assign(<>),
  "return" <Exp> ";" => Stmt::Return(<>),
  <Exp> ";" => Stmt::Exp(<>),
  ";" => Stmt::Empty,
}

MultipleDecl: Vec<SingleDecl> = {
  <SingleDecl> => vec![<>],
  <single_decl: SingleDecl> "," <rest: MultipleDecl> => {
    let mut decls = vec![single_decl];
    decls.extend(rest);
    decls
  }
}

SingleDecl: SingleDecl = {
  <ident: Ident> => SingleDecl { ident: ident, init: None },
  <ident: Ident> "=" <exp: Exp> => SingleDecl { ident: ident, init: Some(exp) },
}

BType: BType = "int" => BType::Int;

Type: Type = {
  "const" <BType> => Type::Const(<>),
  <BType> => Type::Var(<>),
}

Exp: Exp = {
  <LOrExp> => <>,
}

PrimaryExp: Exp = {
  "(" <Exp> ")" => <>,
  <IntConst> => Exp::Number(<>),
  <Ident> => Exp::Ident(<>),
}

UnaryExp: Exp = {
  <PrimaryExp> => <>,
  <op: UnaryOp> <exp: UnaryExp> => Exp::UnaryExp(op, Box::new(exp)),
}

MulExp: Exp = {
  <UnaryExp> => <>,
  <mul_exp: MulExp> <op: MulOp> <unary_exp: UnaryExp> => Exp::BinaryExp(op, Box::new(mul_exp), Box::new(unary_exp)),
}

AddExp: Exp = {
  <MulExp> => <>,
  <add_exp: AddExp> <op: AddOp> <mul_exp: MulExp> => Exp::BinaryExp(op, Box::new(add_exp), Box::new(mul_exp)),
}

UnaryOp: UnaryOp = {
  "+" => UnaryOp::Pos,
  "-" => UnaryOp::Neg,
  "!" => UnaryOp::Not,
}

MulOp: BinaryOp = {
  "*" => BinaryOp::Mul,
  "/" => BinaryOp::Div,
  "%" => BinaryOp::Mod,
}

AddOp: BinaryOp = {
  "+" => BinaryOp::Add,
  "-" => BinaryOp::Sub,
}

RelExp: Exp = {
  AddExp => <>,
  <rel_exp: RelExp> <op: RelOp> <add_exp: AddExp> => Exp::BinaryExp(op, Box::new(rel_exp), Box::new(add_exp)),
}

RelOp: BinaryOp = {
  "<" => BinaryOp::Lt,
  ">" => BinaryOp::Gt,
  "<=" => BinaryOp::Le,
  ">=" => BinaryOp::Ge,
}

EqExp: Exp = {
  RelExp => <>,
  <eq_exp: EqExp> <op: EqOp> <rel_exp: RelExp> => Exp::BinaryExp(op, Box::new(eq_exp), Box::new(rel_exp)),
}

EqOp: BinaryOp = {
  "==" => BinaryOp::Eq,
  "!=" => BinaryOp::Ne,
}

LAndExp: Exp = {
  EqExp => <>,
  <land_exp: LAndExp> "&&" <eq_exp: EqExp> => Exp::BinaryExp(BinaryOp::And, Box::new(land_exp), Box::new(eq_exp)),
}

LOrExp: Exp = {
  LAndExp => <>,
  <lor_exp: LOrExp> "||" <land_exp: LAndExp> => Exp::BinaryExp(BinaryOp::Or, Box::new(lor_exp), Box::new(land_exp)),
}