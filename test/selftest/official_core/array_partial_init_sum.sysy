int a[2][3] = {{1}, {2, 3}};

int main() {
  int b[2][2] = {4, 5, 6};
  int i = 0;
  int sum = 0;
  while (i < 2) {
    int j = 0;
    while (j < 3) {
      sum = sum + a[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  i = 0;
  while (i < 2) {
    int j = 0;
    while (j < 2) {
      sum = sum + b[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  return sum;
}
