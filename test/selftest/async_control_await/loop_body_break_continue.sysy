async int one() {
  return 1;
}

async int main_async() {
  int i = 0;
  int sum = 0;
  while (i < 5) {
    i = i + 1;
    if (i == 2) {
      await one();
      continue;
    }
    sum = sum + await one();
    if (i == 4) {
      break;
    }
  }
  return sum;
}

int main() {
  Promise<int> p = main_async();
  return p.wait();
}
